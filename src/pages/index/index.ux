<template>
  <div class="page">
    <text class="title">Counter</text>
    <div class="dial" onclick="increment">
      <text class="count">{{ count }}</text>
      <text class="hint">tap</text>
    </div>
    <div class="reset" onclick="reset">
      <text class="reset-text">Reset</text>
    </div>
  </div>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'

const STORAGE_KEY = 'count'

export default {
  private: {
    count: 0
  },

  onInit() {
    storage.get({
      key: STORAGE_KEY,
      success: (value) => {
        const saved = parseInt(value, 10)
        if (!isNaN(saved)) {
          this.count = saved
        }
      }
    })
  },

  increment() {
    this.count += 1
    vibrator.vibrate({ mode: 'short' })
    this.save()
  },

  reset() {
    this.count = 0
    vibrator.vibrate({ mode: 'long' })
    this.save()
  },

  save() {
    storage.set({ key: STORAGE_KEY, value: String(this.count) })
  }
}
</script>

<style>
.page {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  justify-content: space-around;
  background-color: #000000;
}

.title {
  font-size: 28px;
  color: #ffffff;
}

.dial {
  width: 180px;
  height: 180px;
  border-radius: 90px;
  background-color: #ff6700;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.count {
  font-size: 64px;
  color: #ffffff;
}

.hint {
  font-size: 20px;
  color: #ffe0cc;
}

.reset {
  width: 160px;
  height: 56px;
  border-radius: 28px;
  background-color: #333333;
  align-items: center;
  justify-content: center;
}

.reset-text {
  font-size: 24px;
  color: #ffffff;
}
</style>
